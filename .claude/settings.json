{
  "permissions": {
    "allow": [
      "Bash(./mvnw -q -pl backend test)",
      "Bash(./mvnw -q -pl backend test -Dtest=*)",
      "Bash(pnpm -C frontend *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/application-local.yml)",
      "Read(./**/target/**)",
      "Read(./frontend/node_modules/**)",
      "Read(./frontend/dist/**)",
      "Edit(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-file.mjs"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.mjs"
            ],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
